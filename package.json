{
  "name": "@develler/remediation-agent",
  "version": "1.0.13",
  "description": "Remediation agent for Node.js/Express and Next.js/Vercel — real-time PII masking and automated code-fix pipeline",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./auto": "./dist/auto.js",
    "./nextjs": "./dist/nextjs/index.js"
  },
  "bin": {
    "remediation-connect": "dist/commands/connect.js",
    "remediation-agent": "dist/commands/setup.js"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Sabs19/remediation-node-package.git"
  },
  "publishConfig": {
    "access": "public",
    "scope": "@develler"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "connect": "node dist/commands/connect.js",
    "test": "tsc --noEmit && node --test dist/tests/**/*.test.js",
    "test:compile": "tsc --project tsconfig.test.json"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "ioredis": "^5.3.0",
    "winston": "^3.13.0"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0",
    "next": ">=14.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "next": "^16.2.9",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
